{
  "compilerOptions": {
    "target":                   "ES2022",
    "module":                   "ESNext",
    "moduleResolution":         "bundler",
    "lib":                      ["ES2022", "DOM", "DOM.Iterable"],
    "strict":                   true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride":       true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck":             true,
    "sourceMap":                true,
    "outDir":                   "dist",
    "rootDir":                  ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
